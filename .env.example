# Postgres connection string (Neon). The Vercel + Neon integration sets this for you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Secret key that Claude's connector URL must carry: https://your-app.vercel.app/api/mcp?key=THIS_VALUE
MCP_KEY=change-me-too

# Comma-separated emails that get the Editor role (review queue) when they sign up.
ADMIN_EMAILS=you@example.com,reviewer@example.com
